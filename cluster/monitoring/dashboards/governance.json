    {
      "type": "timeseries",
      "id": 16,
      "title": "Gateway traffic (per min)",
      "description": "The Gateway only exports global counters - no per-route, per-agent or status labels.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(kavrynt_gateway_requests_total{component=\"gateway\"}[1m])) * 60",
          "legendFormat": "all requests",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(kavrynt_gateway_proxied_requests_total{component=\"gateway\"}[1m])) * 60",
