    {
      "type": "table",
      "id": 11,
      "title": "Expected vs actual (selected time range)",
      "description": "One row per agent, tool and outcome. Rows where policy expects deny/approve but the outcome is ok are the governance gap.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (agent, route, tool, expected, outcome) (round(increase(kavrynt_lab_agent_calls_total[$__range]))) > 0",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "agent": "Agent",
              "route": "Route",
              "tool": "Tool",
              "expected": "Policy expects",
              "outcome": "Actual outcome",
              "Value": "Calls"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Policy expects"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "allow": {
                        "color": "green",
                        "index": 0
                      },
                      "approve": {
                        "color": "purple",
                        "index": 1
                      },
                      "deny": {
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Actual outcome"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "color": "green",
                        "index": 0
                      },
                      "tool_error": {
                        "color": "yellow",
                        "index": 1
                      },
                      "denied": {
                        "color": "blue",
                        "index": 2
                      },
                      "pending_approval": {
                        "color": "purple",
                        "index": 3
                      },
                      "unauthenticated": {
                        "color": "blue",
                        "index": 4
                      },
                      "not_found": {
                        "color": "orange",
                        "index": 5
                      },
                      "upstream_error": {
                        "color": "red",
                        "index": 6
                      },
                      "protocol_error": {
                        "color": "red",
                        "index": 7
                      },
                      "timeout": {
                        "color": "orange",
                        "index": 8
                      },
                      "unreachable": {
                        "color": "dark-red",
                        "index": 9
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Policy expects",
            "desc": true
          }
        ]
      }
    },
