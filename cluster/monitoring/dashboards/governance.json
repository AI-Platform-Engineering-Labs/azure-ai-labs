            },
            "renameByName": {
              "agent": "Caller (X-Lab-Agent)",
              "route": "Route",
              "tool": "Tool",
              "side_effect": "Side effect",
              "Value": "Executions"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
