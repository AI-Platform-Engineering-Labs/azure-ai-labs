    {
      "type": "timeseries",
      "id": 9,
      "title": "Calls by outcome (per min)",
      "description": "Outcome is what the control plane did with the tools/call request, from its real HTTP status.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(kavrynt_lab_agent_calls_total[1m])) * 60",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
